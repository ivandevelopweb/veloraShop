# Never commit a real .env file. Values below are placeholders only.
NODE_ENV=development
PORT=4000
POSTGRES_PASSWORD=<choose-a-strong-local-postgres-password>
DATABASE_URL=postgresql://velora:<your-local-postgres-password>@127.0.0.1:5433/velora
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production: at least 32 random characters.
CSRF_SECRET=<generate-a-long-random-value-before-production>

# Use true only behind HTTPS in production. Development defaults to false.
SESSION_COOKIE_SECURE=false

# Use none for a separately hosted HTTPS frontend and API in production.
COOKIE_SAME_SITE=lax

# Seeded once by `npm run seed`. Fill both fields locally; keep them empty to skip admin seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables image upload in the admin area. Keep the secret server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiqPay stays server-side. Sandbox keys start with sandbox_.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true
# Override only if the public Render API URL changes.
LIQPAY_CALLBACK_URL=https://velora-api-cg44.onrender.com/api/payments/liqpay/callback

# A checkout reserves stock first, then LiqPay is allowed to open its sandbox form.
PAYMENT_RESERVATION_MINUTES=15
# After expiry, retain the reservation during this reconciliation grace period.
PAYMENT_RECONCILIATION_GRACE_MINUTES=10
